# Скопируй в .env и подставь значения sandbox-окружения.
# .env в git не попадает (см. .gitignore).

# Цель
TARGET_HOST=sandbox-session-cand-xxxxxxxx.fly.dev
STORE_URL=https://sandbox-session-cand-xxxxxxxx.fly.dev/
ADMIN_URL=https://sandbox-session-cand-xxxxxxxx.fly.dev/app

# Если пусто — IP определится через DNS-over-HTTPS (scripts/resolve-doh.sh)
TARGET_IP=

# Ключи и креды
PUBLISHABLE_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_EMAIL=admin@sandbox.local
ADMIN_PASSWORD=changeme
